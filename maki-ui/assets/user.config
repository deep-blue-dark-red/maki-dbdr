# Maki UI configuration.
# Every option is commented out and shows its default; uncomment to change.
# Saving from /settings rewrites this file with the active values.

# Show the agent's system prompt at the top of a session.
# show_system_prompt = false

# Log raw provider request/response payloads for debugging.
# api_logging = true

# Show model reasoning while streaming.
# show_reasoning = true

# Show live token usage stats.
# show_token_stats = true

# Shell command the log viewer pipes API logs into.
# log_command = tail -n 30 alog | jlf -c | less -R

# Soft token budget; older messages are compacted beyond it. Unset disables truncation.
# compact_tokens = 100000

# Extra skill directories, searched in addition to the defaults. Repeatable.
# skills_dir = ~/skills

# Where /export writes by default.
# export_path = ~/sessions/export.md

# Plugins forced off or on, overriding package defaults. Repeatable.
# disabled_plugin = status
# enabled_plugin = my_plugin

# Share sessions across all projects instead of per directory.
# global_sessions = false

# Turn spinner on/off and pick its style (braille, dot).
# spinner_enabled = true
# spinner_style = braille

# Label on collapsed messages instead of "click to expand".
# override_expand_string = "click to expand"

# Prefix shown before each user turn; {n} is the turn number. Quotes are
# required, \n escapes a newline.
# user_prompt_prefix = "{n}‧ you ∙ "

# Rebind a key to a built-in action, or run any /command. Repeatable.
# keybind = ctrl+u=/usage
# keybind = ctrl+shift+s=search
